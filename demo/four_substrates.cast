[0.002, "o", "  coyote-apple — one .cy file, four substrates\r\n  cpu · metal/gpu · neural engine · ciphertext\r\n  the compiler proves they all compute the same math\r\n"]
[0.000, "o", "\u001b[0m"]
[2.508, "o", "\r\n\u001b[1;36m── one source file — examples/qwen28.cy (a 28-layer transformer) ──\u001b[0m\r\n"]
[0.718, "o", "// qwen28.cy — a full 28-layer Qwen3-0.6B decode, the organism way.\r\n"]
[0.059, "o", "// 28 programs on the chip, each with its own instanced KV cache;\r\n"]
[0.058, "o", "// the decode loop — gather, dispatch, argmax, witness — is all\r\n"]
[0.055, "o", "// host code. every token generated is witnessed by the organism.\r\n"]
[0.055, "o", "//\r\n"]
[0.057, "o", "//   coyote run examples/qwen28.cy -o out/qwen28\r\n"]
[0.058, "o", "//\r\n"]
