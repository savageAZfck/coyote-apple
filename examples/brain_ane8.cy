// GENERATED by tools/gen_brain.py — do not hand-edit.
// spec: L=1 D=64 Q=4 KV=2 ffn=2x64 V=64 S=64 pos=16 ep=8
// all transformer params born on-chip + trained on-chip (grad+adam);
// kv projections frozen at the state-cache boundary (tape ends at
// StateUpdate — they are used every forward, never updated).

invariant never_sells_self

provenance {
    author: "savage"
    purpose: "organism-grown mind — trainable decoder on ANE"
    license: "BSL-1.1"
}

// ---- layer 0 ----
param l0_ln1: trainable f16[64]
param l0_ln2: trainable f16[64]
param l0_qnl: trainable f16[64]
param l0_qnh: trainable f16[64]
param l0_knl: frozen f16[64]
param l0_knh: frozen f16[64]
param l0_q0lo: trainable f16[64, 64]
param l0_o0lo: trainable f16[64, 64]
param l0_q0hi: trainable f16[64, 64]
param l0_o0hi: trainable f16[64, 64]
param l0_q1lo: trainable f16[64, 64]
param l0_o1lo: trainable f16[64, 64]
param l0_q1hi: trainable f16[64, 64]
param l0_o1hi: trainable f16[64, 64]
param l0_q2lo: trainable f16[64, 64]
param l0_o2lo: trainable f16[64, 64]
param l0_q2hi: trainable f16[64, 64]
param l0_o2hi: trainable f16[64, 64]
param l0_q3lo: trainable f16[64, 64]
param l0_o3lo: trainable f16[64, 64]
param l0_q3hi: trainable f16[64, 64]
param l0_o3hi: trainable f16[64, 64]
param l0_k0lo: frozen f16[64, 64]
param l0_k0hi: frozen f16[64, 64]
param l0_v0lo: frozen f16[64, 64]
param l0_v0hi: frozen f16[64, 64]
param l0_k1lo: frozen f16[64, 64]
param l0_k1hi: frozen f16[64, 64]
param l0_v1lo: frozen f16[64, 64]
param l0_v1hi: frozen f16[64, 64]
param l0_wg0: trainable f16[64, 64]
param l0_wu0: trainable f16[64, 64]
param l0_wd0: trainable f16[64, 64]
param l0_wg1: trainable f16[64, 64]
param l0_wu1: trainable f16[64, 64]
param l0_wd1: trainable f16[64, 64]

param lnf: trainable f16[64]
param lmh: trainable f16[64, 64]

state kv {
    l0_k0lo: f16[64, 64]
    l0_k0hi: f16[64, 64]
    l0_v0lo: f16[64, 64]
    l0_v0hi: f16[64, 64]
    l0_k1lo: f16[64, 64]
    l0_k1hi: f16[64, 64]
    l0_v1lo: f16[64, 64]
    l0_v1hi: f16[64, 64]
}

table emb: f16[151936, 64] @ "models/qwen3-0.6b/model.safetensors::model.embed_tokens.weight[0:151936,0:64]"

table seq: f16[64, 64] @ "corpus.safetensors::seq"

fn forward(
    x: f16[64], pos: f16[64], mask: f16[64],
    cos: f16[64], sin: f16[64]
) -> f16[64] {
    let h0 = rmsnorm(x, l0_ln1);
    let q0_0_lo = rmsnorm(h0 @ l0_q0lo, l0_qnl);
    let q0_0_hi = rmsnorm(h0 @ l0_q0hi, l0_qnh);
    let rq0_0_lo = q0_0_lo * cos - q0_0_hi * sin;
    let rq0_0_hi = q0_0_hi * cos + q0_0_lo * sin;
    let q0_1_lo = rmsnorm(h0 @ l0_q1lo, l0_qnl);
    let q0_1_hi = rmsnorm(h0 @ l0_q1hi, l0_qnh);
    let rq0_1_lo = q0_1_lo * cos - q0_1_hi * sin;
    let rq0_1_hi = q0_1_hi * cos + q0_1_lo * sin;
    let q0_2_lo = rmsnorm(h0 @ l0_q2lo, l0_qnl);
    let q0_2_hi = rmsnorm(h0 @ l0_q2hi, l0_qnh);
    let rq0_2_lo = q0_2_lo * cos - q0_2_hi * sin;
    let rq0_2_hi = q0_2_hi * cos + q0_2_lo * sin;
    let q0_3_lo = rmsnorm(h0 @ l0_q3lo, l0_qnl);
    let q0_3_hi = rmsnorm(h0 @ l0_q3hi, l0_qnh);
    let rq0_3_lo = q0_3_lo * cos - q0_3_hi * sin;
    let rq0_3_hi = q0_3_hi * cos + q0_3_lo * sin;
    let k0_0_lo = rmsnorm(h0 @ l0_k0lo, l0_knl);
    let k0_0_hi = rmsnorm(h0 @ l0_k0hi, l0_knh);
    let v0_0_lo = h0 @ l0_v0lo;
    let v0_0_hi = h0 @ l0_v0hi;
    kv.l0_k0lo[pos] = k0_0_lo;
    kv.l0_k0hi[pos] = k0_0_hi;
    kv.l0_v0lo[pos] = v0_0_lo;
    kv.l0_v0hi[pos] = v0_0_hi;
    let k0_1_lo = rmsnorm(h0 @ l0_k1lo, l0_knl);
    let k0_1_hi = rmsnorm(h0 @ l0_k1hi, l0_knh);
    let v0_1_lo = h0 @ l0_v1lo;
    let v0_1_hi = h0 @ l0_v1hi;
    kv.l0_k1lo[pos] = k0_1_lo;
    kv.l0_k1hi[pos] = k0_1_hi;
    kv.l0_v1lo[pos] = v0_1_lo;
    kv.l0_v1hi[pos] = v0_1_hi;
    let s0_0 = softmax((rq0_0_lo @ kv.l0_k0lo.T + rq0_0_hi @ kv.l0_k0hi.T) * 0.125000 + mask);
    let a0_0 = (s0_0 @ kv.l0_v0lo) @ l0_o0lo + (s0_0 @ kv.l0_v0hi) @ l0_o0hi;
    let s0_1 = softmax((rq0_1_lo @ kv.l0_k0lo.T + rq0_1_hi @ kv.l0_k0hi.T) * 0.125000 + mask);
    let a0_1 = (s0_1 @ kv.l0_v0lo) @ l0_o1lo + (s0_1 @ kv.l0_v0hi) @ l0_o1hi;
    let s0_2 = softmax((rq0_2_lo @ kv.l0_k1lo.T + rq0_2_hi @ kv.l0_k1hi.T) * 0.125000 + mask);
    let a0_2 = (s0_2 @ kv.l0_v1lo) @ l0_o2lo + (s0_2 @ kv.l0_v1hi) @ l0_o2hi;
    let s0_3 = softmax((rq0_3_lo @ kv.l0_k1lo.T + rq0_3_hi @ kv.l0_k1hi.T) * 0.125000 + mask);
    let a0_3 = (s0_3 @ kv.l0_v1lo) @ l0_o3lo + (s0_3 @ kv.l0_v1hi) @ l0_o3hi;
    let att0 = a0_0 + a0_1 + a0_2 + a0_3;
    let r0 = x + att0;
    let n0 = rmsnorm(r0, l0_ln2);
    let f0_0 = (silu(n0 @ l0_wg0) * (n0 @ l0_wu0)) @ l0_wd0;
    let f0_1 = (silu(n0 @ l0_wg1) * (n0 @ l0_wu1)) @ l0_wd1;
    let f0 = r0 + f0_0 + f0_1;
    rmsnorm(f0, lnf) @ lmh
}

// teacher-forced step: forward + adam on every trainable param.
fn train_step(
    x: f16[64], pos: f16[64], mask: f16[64],
    cos: f16[64], sin: f16[64], tgt: f16[64]
) -> f16[64] {
    adam(l0_ln1, grad(mse(forward(x, pos, mask, cos, sin), tgt), l0_ln1), 0.01);
    adam(l0_ln2, grad(mse(forward(x, pos, mask, cos, sin), tgt), l0_ln2), 0.01);
    adam(l0_qnl, grad(mse(forward(x, pos, mask, cos, sin), tgt), l0_qnl), 0.01);
    adam(l0_qnh, grad(mse(forward(x, pos, mask, cos, sin), tgt), l0_qnh), 0.01);
    adam(l0_q0lo, grad(mse(forward(x, pos, mask, cos, sin), tgt), l0_q0lo), 0.05);
    adam(l0_o0lo, grad(mse(forward(x, pos, mask, cos, sin), tgt), l0_o0lo), 0.05);
    adam(l0_q0hi, grad(mse(forward(x, pos, mask, cos, sin), tgt), l0_q0hi), 0.05);
    adam(l0_o0hi, grad(mse(forward(x, pos, mask, cos, sin), tgt), l0_o0hi), 0.05);
    adam(l0_q1lo, grad(mse(forward(x, pos, mask, cos, sin), tgt), l0_q1lo), 0.05);
    adam(l0_o1lo, grad(mse(forward(x, pos, mask, cos, sin), tgt), l0_o1lo), 0.05);
    adam(l0_q1hi, grad(mse(forward(x, pos, mask, cos, sin), tgt), l0_q1hi), 0.05);
    adam(l0_o1hi, grad(mse(forward(x, pos, mask, cos, sin), tgt), l0_o1hi), 0.05);
    adam(l0_q2lo, grad(mse(forward(x, pos, mask, cos, sin), tgt), l0_q2lo), 0.05);
    adam(l0_o2lo, grad(mse(forward(x, pos, mask, cos, sin), tgt), l0_o2lo), 0.05);
    adam(l0_q2hi, grad(mse(forward(x, pos, mask, cos, sin), tgt), l0_q2hi), 0.05);
    adam(l0_o2hi, grad(mse(forward(x, pos, mask, cos, sin), tgt), l0_o2hi), 0.05);
    adam(l0_q3lo, grad(mse(forward(x, pos, mask, cos, sin), tgt), l0_q3lo), 0.05);
    adam(l0_o3lo, grad(mse(forward(x, pos, mask, cos, sin), tgt), l0_o3lo), 0.05);
    adam(l0_q3hi, grad(mse(forward(x, pos, mask, cos, sin), tgt), l0_q3hi), 0.05);
    adam(l0_o3hi, grad(mse(forward(x, pos, mask, cos, sin), tgt), l0_o3hi), 0.05);
    adam(l0_wg0, grad(mse(forward(x, pos, mask, cos, sin), tgt), l0_wg0), 0.05);
    adam(l0_wu0, grad(mse(forward(x, pos, mask, cos, sin), tgt), l0_wu0), 0.05);
    adam(l0_wd0, grad(mse(forward(x, pos, mask, cos, sin), tgt), l0_wd0), 0.05);
    adam(l0_wg1, grad(mse(forward(x, pos, mask, cos, sin), tgt), l0_wg1), 0.05);
    adam(l0_wu1, grad(mse(forward(x, pos, mask, cos, sin), tgt), l0_wu1), 0.05);
    adam(l0_wd1, grad(mse(forward(x, pos, mask, cos, sin), tgt), l0_wd1), 0.05);
    adam(lnf, grad(mse(forward(x, pos, mask, cos, sin), tgt), lnf), 0.01);
    adam(lmh, grad(mse(forward(x, pos, mask, cos, sin), tgt), lmh), 0.05);
    forward(x, pos, mask, cos, sin)
}

host fn main() -> i64 {
    let me = self_token();
    witness("born", me);
    print("brain organism", me.id);

    var ep = 0;
    while ep < 8 {
        var i = 0;
        while i < 16 {
            let x = seq[i];
            let tgt = onehot(i + 1, 64);
            let lg = train_step(
                x,
                onehot(i, 64),
                causal(i, 64),
                rope_cos(i, 64),
                rope_sin(i, 64),
                tgt);
            let pred = argmax(lg);
            print("ep", ep, "pos", i, "pred", pred, "want", i + 1);
            witness("train_pred", pred);
            i += 1;
        }
        ep += 1;
    }

    var tok = 0;
    var x = seq[tok];
    var step = 0;
    while step < 8 {
        let lg = forward(
            x,
            onehot(step % 64, 64),
            causal(step % 64, 64),
            rope_cos(step % 64, 64),
            rope_sin(step % 64, 64)
        );
        tok = argmax(lg);
        print("gen", step, "tok", tok);
        witness("tok", tok);
        x = seq[tok % 64];
        step += 1;
    }
    witness("done", step);
    return tok;
}
